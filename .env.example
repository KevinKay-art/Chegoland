# GEMINI_API_KEY: Required for Gemini AI API calls (Ask Chegoland chat & Farm Insights).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Password to access the /admin farm dashboard.
# Defaults to "chegoland2026" in local/preview environments if unset.
ADMIN_PASSWORD="chegoland2026"

# M-Pesa Daraja API Configuration (leave Consumer Key/Secret empty to use local simulator)
# Public Sandbox Shortcode & Passkey are prefilled below; add your own Consumer Key/Secret from developer.safaricom.co.ke
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="174379"
MPESA_PASSKEY="bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919"
MPESA_CALLBACK_URL=""
